# ── Google Drive ────────────────────────────────────────────────────────────
# File ID of the Word template in Google Drive.
# Get it from the URL: drive.google.com/file/d/FILE_ID/view
TEMPLATE_FILE_ID=YOUR_TEMPLATE_FILE_ID_HERE

# Spreadsheet ID of the Google Sheet with tenant data.
# Get it from the URL: docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=YOUR_SPREADSHEET_ID_HERE

# Sheet tab name and data range (skip the header row with A2).
# Change "Sheet1" if your tab has a different name.
SHEET_RANGE=Sheet1!A2:N

# ── Scheduling ───────────────────────────────────────────────────────────────
# Day of the month this script is triggered (1-28).
# Must match the day configured in Windows Task Scheduler.
TRIGGER_DAY=7

# Day of the month shown as payment date in the receipt.
# Can differ from TRIGGER_DAY (e.g., script runs on 7th, payment was on 5th).
PAYMENT_DAY=5

# ── Landlord ─────────────────────────────────────────────────────────────────
# Your Gmail address — receives run summary and error alert emails.
LANDLORD_EMAIL=your.email@gmail.com

# ── OAuth Paths ──────────────────────────────────────────────────────────────
# Path to the client_secret.json downloaded from GCP Console.
CLIENT_SECRET_PATH=credentials/client_secret.json

# Path where the OAuth token will be saved after the first browser auth.
TOKEN_PATH=credentials/token.json

# ── Idempotency ──────────────────────────────────────────────────────────────
# JSON file that records which months have already been processed.
# Prevents duplicate receipts if the script is run twice in the same month.
PROCESSED_MONTHS_PATH=processed_months.json

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_FILE=logs/quittance.log
LOG_LEVEL=INFO
